<!--
  Vento's tray flyout, shaped like Windows 11 Quick Settings: acrylic, a row
  of tiles for the fan modes, one slider, the numbers that matter, and a
  footer that opens the full app. Opened from the tray icon (app.ps1).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vento quick settings" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextPrimaryBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Border x:Name="FTint" Background="#40101216"/>
    <StackPanel x:Name="FBody">
      <StackPanel Margin="18,16,18,14">
        <Grid>
          <StackPanel Orientation="Horizontal">
            <!-- expand: leave the mini panel for the full window -->
            <Button x:Name="QExpand" Style="{StaticResource IconButton}" Content="&#xE740;" FontSize="13" Margin="-8,-4,4,-4" ToolTip="Open the full window"/>
            <Image Source="__LOGO__vento-40.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Vento" Style="{StaticResource BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse x:Name="FDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="FBoard" Text="Board 59&#xB0;" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>

        <UniformGrid Columns="3" Margin="-4,14,-4,0">
          <StackPanel Margin="4,0,4,10">
            <RadioButton x:Name="QQuiet" GroupName="QMode" Style="{StaticResource QuickTile}" Tag="Quiet">
              <TextBlock Text="&#xF1E8;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
            </RadioButton>
            <TextBlock Text="Quiet" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Margin="4,0,4,10">
            <RadioButton x:Name="QNormal" GroupName="QMode" Style="{StaticResource QuickTile}" Tag="Normal">
              <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
            </RadioButton>
            <TextBlock Text="Normal" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Margin="4,0,4,10">
            <RadioButton x:Name="QPerf" GroupName="QMode" Style="{StaticResource QuickTile}" Tag="Perf">
              <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
            </RadioButton>
            <TextBlock Text="Performance" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Margin="4,0,4,0">
            <RadioButton x:Name="QCurve" GroupName="QMode" Style="{StaticResource QuickTile}" Tag="Curve">
              <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
            </RadioButton>
            <TextBlock Text="Curve" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Margin="4,0,4,0">
            <RadioButton x:Name="QAuto" GroupName="QMode" Style="{StaticResource QuickTile}" Tag="Auto">
              <Viewbox Width="17" Height="17"><Path Data="{StaticResource AutoGeometry}" Style="{StaticResource FluentIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/></Viewbox>
            </RadioButton>
            <TextBlock Text="Auto" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
          <StackPanel Margin="4,0,4,0">
            <CheckBox x:Name="QOverlay" Style="{StaticResource QuickTile}">
              <TextBlock Text="&#xE81E;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
            </CheckBox>
            <TextBlock Text="Overlay" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </UniformGrid>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
          <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
            <Path Data="{StaticResource FanGeometrySmall}" Style="{StaticResource FluentIcon}" Fill="{StaticResource TextPrimaryBrush}"/>
          </Viewbox>
          <Slider x:Name="QCase" Grid.Column="1" Style="{StaticResource FluentSlider}" Minimum="20" Maximum="100" Value="30" IsSnapToTickEnabled="True" TickFrequency="1" ToolTip="Case fan speed in this mode"/>
          <TextBlock x:Name="QCaseV" Grid.Column="2" Text="30%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <UniformGrid Columns="3" Margin="-3,14,-3,0">
          <Border CornerRadius="6" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" Margin="3,0" Padding="10,7">
            <StackPanel>
              <TextBlock Text="CPU" Style="{StaticResource CaptionTertiary}"/>
              <TextBlock x:Name="QCpu" Text="60&#xB0;" Style="{StaticResource Metric}" FontSize="16"/>
            </StackPanel>
          </Border>
          <Border CornerRadius="6" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" Margin="3,0" Padding="10,7">
            <StackPanel>
              <TextBlock Text="GPU" Style="{StaticResource CaptionTertiary}"/>
              <TextBlock x:Name="QGpu" Text="54&#xB0;" Style="{StaticResource Metric}" FontSize="16"/>
            </StackPanel>
          </Border>
          <Border CornerRadius="6" Background="#0AFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" Margin="3,0" Padding="10,7">
            <StackPanel>
              <TextBlock Text="CPU FAN" Style="{StaticResource CaptionTertiary}"/>
              <TextBlock x:Name="QRpm" Text="1951" Style="{StaticResource Metric}" FontSize="16"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- the first connected Bluetooth device with a battery (AirPods first) -->
        <Grid x:Name="QDevRow" Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="QDevGlyph" Text="&#xE7F6;" Style="{StaticResource Glyph}" FontSize="15"/>
            <TextBlock x:Name="QPodName" Text="AirPods" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel x:Name="QDevVals" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>

      <!-- Footer band, as in Quick Settings -->
      <Border Background="#26000000" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="12,6,8,6">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock x:Name="QProfile" Text="No profile" Style="{StaticResource Caption}" Margin="10,0,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="QOpen" Style="{StaticResource LinkButton}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Open Vento" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="QSettings" Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14" ToolTip="Settings"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </Grid>
</Window>
