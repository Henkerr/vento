<!--
  Vento main window (1.8 "Glass" design). Windows 11 look: the DWM Mica
  backdrop behind a transparent WPF surface (set up by app.ps1), a
  Settings-style navigation pane and one page per area. Styles and colors
  come from ui/theme.xaml, merged into Application resources first.
  __LOGO__ / __ACCENT*__ placeholders are filled in by app.ps1 at load.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vento" Width="1120" Height="868" MinWidth="1000" MinHeight="640"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextPrimaryBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="48" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Overlay theme in use; Glass.ps1 swaps these when a color is picked -->
    <SolidColorBrush x:Key="OsdAccentBrush" Color="#6FB1FF"/>
    <SolidColorBrush x:Key="OsdPanelBrush" Color="#DC0A0D13"/>
    <SolidColorBrush x:Key="OsdBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="OsdInkBrush" Color="#EDF1F8"/>
    <SolidColorBrush x:Key="OsdLabBrush" Color="#8FA3BC"/>
    <LinearGradientBrush x:Key="SceneBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1B2A3A" Offset="0"/>
      <GradientStop Color="#3A2533" Offset="0.55"/>
      <GradientStop Color="#4A3020" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="MiniScene" TargetType="Border">
      <Setter Property="Height" Value="70"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Background" Value="{StaticResource SceneBrush}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="OsdTiny" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="Foreground" Value="{DynamicResource OsdInkBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <!-- Deepens acrylic a touch so text keeps its contrast; Mica needs none -->
    <Border x:Name="Tint" Background="#59101216"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Title bar (drag area; the caption buttons are Windows' own) -->
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Image Source="__LOGO__vento-32.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Vento" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <TextBlock Text="Live" Style="{StaticResource CaptionTertiary}" Margin="7,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <!-- Navigation pane, laid out like the Settings app: account-style
           card, "Find a setting" search, then one flat list of pages -->
      <Grid x:Name="NavGrid" Grid.Row="1" Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="16,2,16,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- the app logo stands in for the account picture -->
          <Image x:Name="AvatarFan" Source="__LOGO__vento-128.png" Width="72" Height="72" Margin="-4" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="PcName" Text="This PC" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PcBoard" Text="" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
        <TextBox x:Name="Search" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="16,0,16,14"/>

        <StackPanel Grid.Row="2" Margin="8,0,8,0">
          <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True" Tag="PageHome">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Home" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavFans" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageFans">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16"><Path Data="{StaticResource FanGeometrySmall}" Style="{StaticResource FluentIcon}" Fill="{StaticResource TextPrimaryBrush}"/></Viewbox>
              <TextBlock Text="Fans" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavAlerts" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageAlerts">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Alerts" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavProfiles" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageProfiles">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Profiles" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavDisplays" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageDisplays">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Displays" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavPods" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PagePods">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE702;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Devices" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavOverlay" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageOverlay">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81E;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Overlay" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavLights" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageLights" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA80;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Lights" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageSettings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Settings" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <!-- One selection pill for the whole pane; it slides to the picked item -->
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
          <Border x:Name="NavPill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource AccentBrush}">
            <Border.RenderTransform><TranslateTransform x:Name="NavPillT"/></Border.RenderTransform>
          </Border>
        </Canvas>
      </Grid>

      <!-- Content sheet -->
      <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource LayerStrokeBrush}"
              BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
        <Grid x:Name="Pages">

          <!-- ============================ HOME ============================ -->
          <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <Grid>
                <StackPanel>
                  <TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
                  <TextBlock x:Name="HomeStatus" Text="All quiet. The board is 3&#xB0; under its target." Style="{StaticResource Body}"
                             Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <TextBlock Text="Profile" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <!-- one chip per Vento profile, built by app.ps1 -->
                  <StackPanel x:Name="HomeProfiles" Orientation="Horizontal"/>
                </StackPanel>
              </Grid>

              <!-- Error InfoBar: the fan driver (PawnIO) is missing or stopped.
                   Shown instead of letting fan control fail silently. -->
              <Border x:Name="DriverBar" CornerRadius="4" Background="#442E1F22" BorderBrush="#33FF99A4" BorderThickness="1" Padding="14,10,8,10" Margin="0,20,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="18" Height="18" CornerRadius="9" Background="#FF99A4" VerticalAlignment="Top" Margin="0,1,0,0">
                    <TextBlock Text="!" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock x:Name="DriverTitle" Text="Fan control is paused" Style="{StaticResource BodyStrong}"/>
                    <TextBlock x:Name="DriverMsg" Text="Vento can't reach the fan controller: the PawnIO driver is missing. Your fans are running on their BIOS settings until it is back." Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DriverFix" Style="{StaticResource AccentButton}" Content="Install driver" FontSize="13" MinHeight="28" Padding="12,3"/>
                    <Button x:Name="DriverClose" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="Dismiss"/>
                  </StackPanel>
                </Grid>
              </Border>
              <!-- InfoBar: an update that is downloaded and verified -->
              <Border x:Name="InfoBar" CornerRadius="4" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14,8,8,8" Margin="0,20,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="InfoIconBg" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="InfoIcon" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="InfoTitle" Text="Vento 1.8.0 is ready" Style="{StaticResource BodyStrong}"/>
                    <TextBlock x:Name="InfoMsg" Text="Downloaded and verified. Restart to finish updating." Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0"/>
                  </StackPanel>
                  <Button x:Name="InfoRestart" Grid.Column="2" Style="{StaticResource AccentButton}" Content="Restart now" FontSize="13" MinHeight="28" Padding="12,3" Margin="12,0,6,0"/>
                  <Button x:Name="InfoClose" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Dismiss"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Height="208" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- thermal glow: follows the board's state -->
                  <Border Grid.ColumnSpan="2" CornerRadius="8" IsHitTestVisible="False">
                    <Border.Background>
                      <RadialGradientBrush Center="0.1,0.3" GradientOrigin="0.1,0.3" RadiusX="0.5" RadiusY="1.2">
                        <GradientStop x:Name="HeroGlowStop" Color="#2A4CC2FF" Offset="0"/>
                        <GradientStop x:Name="HeroGlowEnd" Color="#004CC2FF" Offset="1"/>
                      </RadialGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel Margin="24,20,8,0">
                    <!-- which sensor the hero follows: hottest (auto) or a fixed one -->
                    <Button x:Name="HeroPick" Style="{StaticResource IconButton}" Width="Auto" Height="28" HorizontalAlignment="Left"
                            Margin="-8,-4,0,-4" Padding="0" FontFamily="{StaticResource TextFont}" ToolTip="Choose which temperature to show">
                      <StackPanel Orientation="Horizontal" Margin="8,0">
                        <TextBlock Text="&#xE9CA;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="HeroLabel" Text="Temperature" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <Button.ContextMenu>
                        <ContextMenu x:Name="HeroMenu" Style="{StaticResource FluentMenu}">
                          <MenuItem x:Name="HeroAuto" Header="Hottest (automatic)" Tag="auto" Style="{StaticResource FluentMenuItem}"/>
                          <MenuItem x:Name="HeroCpu" Header="CPU" Tag="cpu" Style="{StaticResource FluentMenuItem}"/>
                          <MenuItem x:Name="HeroGpu" Header="GPU" Tag="gpu" Style="{StaticResource FluentMenuItem}"/>
                          <MenuItem x:Name="HeroSsd" Header="SSD" Tag="ssd" Style="{StaticResource FluentMenuItem}"/>
                          <MenuItem x:Name="HeroBoard" Header="Motherboard" Tag="board" Style="{StaticResource FluentMenuItem}"/>
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <StackPanel x:Name="HeroTempHost" Orientation="Horizontal" Background="Transparent" HorizontalAlignment="Left">
                      <TextBlock x:Name="HeroTemp" Text="59" FontFamily="Segoe UI" FontSize="60" FontWeight="SemiBold"
                                 Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Ideal" Margin="0,0,0,2"/>
                      <TextBlock Text="&#xB0;C" FontFamily="Segoe UI" FontSize="24" FontWeight="Normal"
                                 Foreground="{StaticResource TextSecondaryBrush}" Margin="6,14,0,0"/>
                    </StackPanel>
                    <Border x:Name="HeroChip" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left" Padding="10,3,10,4" Margin="0,-2,0,16">
                      <TextBlock x:Name="HeroChipText" Text="Nearing target &#xB7; 3&#xB0; below" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextBrush}"/>
                    </Border>
                    <!-- Headroom: where the board sits between idle and alarm -->
                    <Grid x:Name="MeterHost" Height="32">
                      <Border Height="6" CornerRadius="3" VerticalAlignment="Top" Margin="0,5,0,0" Opacity="0.9">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="MeterStop0" Color="__ACCENT__" Offset="0"/>
                            <GradientStop x:Name="MeterStop1" Color="__ACCENT__" Offset="0.45"/>
                            <GradientStop Color="#FFB547" Offset="0.72"/>
                            <GradientStop Color="#FF8A80" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                      <Canvas x:Name="MeterMarks"/>
                      <TextBlock Text="40&#xB0;" Style="{StaticResource CaptionTertiary}" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                      <TextBlock Text="85&#xB0;" Style="{StaticResource CaptionTertiary}" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                  <Grid Grid.Column="1" Margin="8,18,22,18">
                    <TextBlock Text="Last 10 minutes" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Canvas x:Name="HeroChart" Margin="0,26,0,0"/>
                  </Grid>
                </Grid>
              </Border>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14,16,14">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Text="Sensors" Style="{StaticResource BodyStrong}"/>
                      <TextBlock Text="&#xB0;C" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE950;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock x:Name="NCpu" Text="CPU" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" x:Name="TCpu" Text="60&#xB0;" Style="{StaticResource Metric}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xF211;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="GPU" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock x:Name="NGpu" Text="GPU" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" x:Name="TGpu" Text="54&#xB0;" Style="{StaticResource Metric}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="SSD" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock x:Name="NSsd" Text="SSD" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" x:Name="TSsd" Text="42&#xB0;" Style="{StaticResource Metric}" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14,16,14">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Text="Fans" Style="{StaticResource BodyStrong}"/>
                      <TextBlock x:Name="HomeFansMode" Text="Quiet" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}">
                        <Path x:Name="SpinCpu" Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU fan" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock x:Name="DutyCpu" Text="62% duty" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="RCpu" Text="1951" Style="{StaticResource Metric}"/>
                        <TextBlock Text="rpm" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}">
                        <Path x:Name="SpinCase" Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Case fans" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock x:Name="DutyCase" Text="30% duty" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="RCase" Text="717" Style="{StaticResource Metric}"/>
                        <TextBlock Text="rpm" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}">
                        <Path x:Name="SpinGpu" Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="GPU fans" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock Text="33% duty" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="RGpu" Text="1018" Style="{StaticResource Metric}"/>
                        <TextBlock Text="rpm" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14,16,14">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Text="Devices" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                      <!-- page through: one battery page per device, then the list -->
                      <StackPanel x:Name="DevPager" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-6,-8,-6">
                        <TextBlock x:Name="DevPageText" Text="1 / 2" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="DevPrev" Style="{StaticResource IconButton}" Content="&#xE76B;" Width="28" Height="28" FontSize="11" ToolTip="Previous"/>
                        <Button x:Name="DevNext" Style="{StaticResource IconButton}" Content="&#xE76C;" Width="28" Height="28" FontSize="11" ToolTip="Next"/>
                      </StackPanel>
                    </Grid>
                    <!-- connected wireless devices and their battery, filled by Glass.ps1 -->
                    <Grid x:Name="HomeDevHost" Height="146" ClipToBounds="True"><StackPanel x:Name="HomeDevices"/></Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,14,12,12">
                <StackPanel>
                  <Grid Margin="4,0,4,12">
                    <TextBlock Text="Fan mode" Style="{StaticResource BodyStrong}"/>
                    <TextBlock Text="Applies instantly" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <UniformGrid Columns="5">
                    <RadioButton x:Name="MQuiet" GroupName="HomeMode" Style="{StaticResource ModeCard}" IsChecked="True" Tag="Quiet">
                      <StackPanel>
                        <TextBlock Text="&#xF1E8;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Quiet" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Silent until warm" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MNormal" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Normal">
                      <StackPanel>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Normal" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Balanced every day" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MPerf" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Perf">
                      <StackPanel>
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Performance" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Airflow first" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MCurve" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Curve">
                      <StackPanel>
                        <TextBlock Text="&#xE9E9;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Curve" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Your own fan curve" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MAuto" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Auto">
                      <StackPanel>
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Left"><Path Data="{StaticResource AutoGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentTextBrush}"/></Viewbox>
                        <TextBlock Text="Auto" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Follows your apps" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ============================ FANS ============================ -->
          <ScrollViewer x:Name="PageFans" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Fans" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Pick a mode, then fine-tune it. Changes reach the fan controller right away." Style="{StaticResource Body}"
                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}">
                    <Path Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{StaticResource TextPrimaryBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Fan mode" Style="{StaticResource Body}"/>
                    <TextBlock Text="How Vento drives the case and CPU fans" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="FQuiet" GroupName="FansMode" Style="{StaticResource SegItem}" Content="Quiet" IsChecked="True" Tag="Quiet"/>
                      <RadioButton x:Name="FNormal" GroupName="FansMode" Style="{StaticResource SegItem}" Content="Normal" Tag="Normal"/>
                      <RadioButton x:Name="FPerf" GroupName="FansMode" Style="{StaticResource SegItem}" Content="Performance" Tag="Perf"/>
                      <RadioButton x:Name="FCurve" GroupName="FansMode" Style="{StaticResource SegItem}" Content="Curve" Tag="Curve"/>
                      <RadioButton x:Name="FAuto" GroupName="FansMode" Style="{StaticResource SegItem}" Content="Auto" Tag="Auto"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Grid Margin="0,20,0,8">
                <TextBlock x:Name="FansSection" Text="Quiet mode" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                <Button x:Name="FansReset" Style="{StaticResource FluentButton}" Content="Reset to defaults" FontSize="13" MinHeight="28" Padding="12,3" HorizontalAlignment="Right"/>
              </Grid>
              <!-- Auto: the motherboard drives the fans -->
              <Border x:Name="FAutoHint" Style="{StaticResource SettingsCard}" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="The motherboard is driving the fans" Style="{StaticResource Body}"/>
                    <TextBlock Text="Pick another mode to set the speeds yourself." Style="{StaticResource Caption}"/>
                  </StackPanel>
                </Grid>
              </Border>
              <StackPanel x:Name="SlidersPanel">
                <!-- Quiet only: the boost that wakes the case fans when the board heats up -->
                <Border x:Name="FBoostCard" Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock Text="Cooling boost" Style="{StaticResource Body}"/>
                      <TextBlock Text="Speeds the case fans up while the CPU or GPU runs hot, then settles back" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <CheckBox x:Name="FBoostOn" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                  </Grid>
                </Border>
                <Border x:Name="FSlot1" Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock x:Name="FI1" Text="&#xEC4A;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock x:Name="FL1" Text="Setting" Style="{StaticResource Body}"/>
                      <TextBlock x:Name="FC1" Text="" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="V1" Text="" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="S1" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                </Border>
                <Border x:Name="FSlot2" Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock x:Name="FI2" Text="&#xEC4A;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock x:Name="FL2" Text="Setting" Style="{StaticResource Body}"/>
                      <TextBlock x:Name="FC2" Text="" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="V2" Text="" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="S2" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                </Border>
                <Border x:Name="FSlot3" Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock x:Name="FI3" Text="&#xEC4A;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock x:Name="FL3" Text="Setting" Style="{StaticResource Body}"/>
                      <TextBlock x:Name="FC3" Text="" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="V3" Text="" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="S3" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                </Border>
                <Border x:Name="FSlot4" Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock x:Name="FI4" Text="&#xEC4A;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock x:Name="FL4" Text="Setting" Style="{StaticResource Body}"/>
                      <TextBlock x:Name="FC4" Text="" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="V4" Text="" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="S4" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                </Border>
              </StackPanel>

              <!-- Curve mode: drag the four points -->
              <Border x:Name="CurvePanel" Style="{StaticResource Card}" Padding="18,14,18,12" Visibility="Collapsed">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <StackPanel>
                      <TextBlock Text="Case fan curve" Style="{StaticResource Body}"/>
                      <TextBlock Text="Drag a point up or down. Case fans follow the hotter of CPU and GPU along this line." Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <Button x:Name="CurveReset" Style="{StaticResource FluentButton}" Content="Reset" FontSize="13" MinHeight="28" Padding="12,3" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <Canvas x:Name="CurveCanvas" Height="230" Background="Transparent"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Activity" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource Card}" Padding="18,14,18,12">
                <StackPanel>
                  <Grid Margin="0,0,0,10">
                    <TextBlock Text="Last 10 minutes" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Ellipse Width="8" Height="8" Fill="#E6FFFFFF" VerticalAlignment="Center"/>
                      <TextBlock Text="CPU fan" Style="{StaticResource Caption}" Margin="8,0,18,0"/>
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="Case fans" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Canvas x:Name="FansChart" Height="120"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ============================ ALERTS ========================== -->
          <ScrollViewer x:Name="PageAlerts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Alerts" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="When Vento should warn you, and when it should step in on its own." Style="{StaticResource Body}"
                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>

              <TextBlock Text="Comfort targets" Style="{StaticResource BodyStrong}" Margin="0,0,0,2"/>
              <TextBlock Text="Above its target a part turns warm on Home. The fans keep working as set." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <Border Style="{StaticResource Card}" Padding="16,2,16,2">
                <StackPanel>
                  <Grid MinHeight="56">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE950;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0"/>
                    <TextBlock Grid.Column="2" x:Name="WCpuV" Text="65&#xB0;" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="WCpu" Style="{StaticResource FluentSlider}" Minimum="50" Maximum="80" Value="65" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                  <Border Height="1" Background="{StaticResource DividerBrush}"/>
                  <Grid MinHeight="56">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xF211;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Text="GPU" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0"/>
                    <TextBlock Grid.Column="2" x:Name="WGpuV" Text="65&#xB0;" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="WGpu" Style="{StaticResource FluentSlider}" Minimum="50" Maximum="80" Value="65" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                  <Border Height="1" Background="{StaticResource DividerBrush}"/>
                  <Grid MinHeight="56">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Text="SSD" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0"/>
                    <TextBlock Grid.Column="2" x:Name="WSsdV" Text="60&#xB0;" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="WSsd" Style="{StaticResource FluentSlider}" Minimum="45" Maximum="75" Value="60" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                  <Border Height="1" Background="{StaticResource DividerBrush}"/>
                  <Grid MinHeight="56">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE964;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <TextBlock Grid.Column="1" Text="Board" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0"/>
                    <TextBlock Grid.Column="2" x:Name="WMbV" Text="62&#xB0;" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="3" x:Name="WMb" Style="{StaticResource FluentSlider}" Minimum="45" Maximum="75" Value="62" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock Text="Safety limits" Style="{StaticResource BodyStrong}" Margin="0,20,0,2"/>
              <TextBlock Text="Past these, Vento takes over: fans go back to Auto whatever mode you are in, and you get a notification." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#FFB547" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="CPU limit" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="LimCpuCap" Text="Processor" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" x:Name="LimCpuV" Text="85&#xB0;" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" x:Name="LimCpu" Style="{StaticResource FluentSlider}" Minimum="70" Maximum="95" Value="85" IsSnapToTickEnabled="True" TickFrequency="1"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#FFB547" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="GPU limit" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="LimGpuCap" Text="Graphics card" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" x:Name="LimGpuV" Text="83&#xB0;" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" x:Name="LimGpu" Style="{StaticResource FluentSlider}" Minimum="70" Maximum="95" Value="83" IsSnapToTickEnabled="True" TickFrequency="1"/>
                </Grid>
              </Border>

              <TextBlock Text="Game detection" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Switch fans when a game starts" Style="{StaticResource Body}"/>
                    <TextBlock Text="Watches GPU load and switches the fan mode while you play" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="GameOn" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
              <StackPanel x:Name="GameRows">
                <Border Style="{StaticResource SettingsCard}">
                  <Grid Margin="52,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="GPU load above" Style="{StaticResource Body}"/>
                      <TextBlock Text="Counts as playing once the GPU stays this busy" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="GameLoadV" Text="80%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="2" x:Name="GameLoad" Style="{StaticResource FluentSlider}" Minimum="50" Maximum="100" Value="80" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                  <Grid Margin="52,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Switch to" Style="{StaticResource Body}"/>
                      <TextBlock Text="The mode used while you play" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource SegHost}">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="GaPerf" GroupName="GameAct" Style="{StaticResource SegItem}" Content="Performance" Tag="performance"/>
                        <RadioButton x:Name="GaCurve" GroupName="GameAct" Style="{StaticResource SegItem}" Content="Curve" Tag="curve"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                  <Grid Margin="52,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Keep going after" Style="{StaticResource Body}"/>
                      <TextBlock Text="Extra seconds at game speed once the game ends, to clear the heat" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="GameCoolV" Text="15 s" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Slider Grid.Column="2" x:Name="GameCool" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="60" Value="15" IsSnapToTickEnabled="True" TickFrequency="1"/>
                  </Grid>
                </Border>
              </StackPanel>

              <TextBlock Text="Notifications" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Windows notifications" Style="{StaticResource Body}"/>
                    <TextBlock Text="Safety, low battery and update notices in the Windows notification center" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Button x:Name="TestToast" Grid.Column="2" Style="{StaticResource FluentButton}" Content="Send a test" FontSize="13" MinHeight="30" Padding="12,4" Margin="0,0,16,0" VerticalAlignment="Center"/>
                  <CheckBox x:Name="ToastOn" Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ========================== PROFILES ========================== -->
          <ScrollViewer x:Name="PageProfiles" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Profiles" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="One name for fans, overlay and displays together. Switch here, from the tray, or with a shortcut." Style="{StaticResource Body}"
                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>
              <!-- one card per Vento profile plus a New tile, built by app.ps1 -->
              <UniformGrid x:Name="ProfileHost" Columns="2"/>
              <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE765;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Next profile shortcut" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="CycleKeyText" Text="Step through your profiles from anywhere" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Button x:Name="GoHotkeys" Grid.Column="2" Style="{StaticResource FluentButton}" Content="Set in Settings" FontSize="13" MinHeight="30" Padding="12,4"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ========================== DISPLAYS ========================== -->
          <ScrollViewer x:Name="PageDisplays" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Displays" Style="{StaticResource PageTitle}"/>
              <Grid Margin="0,4,0,20">
                <TextBlock Text="Brightness and contrast are set inside the monitors themselves, over DDC/CI." Style="{StaticResource Body}"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,300,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="DispStatus" Text="Reading monitors..." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="DispIdentify" Style="{StaticResource FluentButton}" Content="Identify" FontSize="13" MinHeight="30" Padding="12,4" Margin="0,0,8,0" ToolTip="Flash each display so you can tell which card is which"/>
                  <Button x:Name="DispRescan" Style="{StaticResource FluentButton}" FontSize="13" MinHeight="30" Padding="10,4" ToolTip="Read the displays again">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="Rescan" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- input switch safety net: reverts unless kept -->
              <Border x:Name="DispRevertBar" CornerRadius="4" Background="#33FFB547" BorderBrush="#55FFB547" BorderThickness="1" Padding="14,8,8,8" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#FFD08A" Margin="0,0,12,0"/>
                    <TextBlock x:Name="DispRevertText" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DispRevertKeep" Style="{StaticResource AccentButton}" Content="Keep" FontSize="13" MinHeight="30" Padding="16,4"/>
                    <Button x:Name="DispRevertNow" Style="{StaticResource FluentButton}" Content="Go back now" FontSize="13" MinHeight="30" Padding="12,4" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border x:Name="DispPresetCard" Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Preset" Style="{StaticResource Body}"/>
                    <TextBlock Text="Brightness, contrast and color for every display in one tap" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Style="{StaticResource SegHost}" ToolTip="Right-click a preset to update or delete it">
                    <StackPanel x:Name="DispPresets" Orientation="Horizontal"/>
                  </Border>
                  <Button x:Name="DispPresetAdd" Style="{StaticResource IconButton}" Content="&#xE710;" Margin="6,0,0,0" ToolTip="Save the current levels as a new preset"/>
                  </StackPanel>
                </Grid>
              </Border>
              <!-- one card per display, built from the DDC snapshot -->
              <UniformGrid x:Name="MonHost" Columns="2"/>
              <TextBlock x:Name="DispNote" Style="{StaticResource Caption}" Foreground="#FFD08A" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

              <TextBlock Text="All displays" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE9A9;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Match brightness and contrast" Style="{StaticResource Body}"/>
                    <TextBlock Text="Move one slider and every display follows" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="DispSync" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Night schedule" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="NightText" Text="Dims every display at night" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button x:Name="NightFromDn" Style="{StaticResource IconButton}" Content="&#xE76B;" Width="28" Height="28" FontSize="10" ToolTip="Start 30 minutes earlier"/>
                    <TextBlock x:Name="NightFrom" Text="23:00" Style="{StaticResource Body}" Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="NightFromUp" Style="{StaticResource IconButton}" Content="&#xE76C;" Width="28" Height="28" FontSize="10" ToolTip="Start 30 minutes later"/>
                    <TextBlock Text="&#x2013;" Style="{StaticResource Body}" Margin="8,0" VerticalAlignment="Center"/>
                    <Button x:Name="NightToDn" Style="{StaticResource IconButton}" Content="&#xE76B;" Width="28" Height="28" FontSize="10" ToolTip="End 30 minutes earlier"/>
                    <TextBlock x:Name="NightTo" Text="07:00" Style="{StaticResource Body}" Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="NightToUp" Style="{StaticResource IconButton}" Content="&#xE76C;" Width="28" Height="28" FontSize="10" ToolTip="End 30 minutes later"/>
                  </StackPanel>
                  <CheckBox x:Name="NightOn" Grid.Column="3" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== AIRPODS ========================== -->
          <ScrollViewer x:Name="PagePods" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Devices" Style="{StaticResource PageTitle}"/>
              <Grid Margin="0,4,0,20">
                <TextBlock Text="Battery for headphones, mice, keyboards and controllers." Style="{StaticResource Body}"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,330,0" TextTrimming="CharacterEllipsis"/>
                <!-- battery is read on a schedule, not constantly: when it was, and a button to look now -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="DevChecked" Text="Checking..." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="DevRefresh" Style="{StaticResource FluentButton}" FontSize="13" MinHeight="30" Padding="10,4" ToolTip="Check battery now">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <!-- Two tabs: AirPods (only while a pair is connected) and every
                   other connected device. Paired-but-away devices never show. -->
              <Border x:Name="DevTabs" Style="{StaticResource SegHost}" HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TabPods" GroupName="DevTab" Style="{StaticResource SegItem}" Content="AirPods" IsChecked="True"/>
                  <RadioButton x:Name="TabOther" GroupName="DevTab" Style="{StaticResource SegItem}" Content="Other devices"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="PodsPanel">
              <Border Style="{StaticResource Card}" Padding="28,22,28,26">
                <StackPanel>
                  <Grid Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="22">
                        <TextBlock Text="&#xE7F6;" Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PodName" Text="AirPods" Style="{StaticResource Subtitle}" FontSize="18"/>
                        <TextBlock x:Name="PodSub" Text="Connected" Style="{StaticResource Caption}" MaxWidth="330" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                      </StackPanel>
                    </StackPanel>
                    <!-- on-demand read: listen for the AirPods' battery broadcast right now -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock x:Name="PodsUpdated" Text="Updated 12 min ago" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <Button x:Name="PodsForget" Style="{StaticResource FluentButton}" Content="Forget" FontSize="13" MinHeight="30" Padding="12,4" Margin="0,0,8,0" ToolTip="Stop following this pair; the next AirPods held close to the PC take their place"/>
                      <Button x:Name="PodsCheck" Style="{StaticResource FluentButton}" FontSize="13" MinHeight="30" Padding="10,4" ToolTip="Read the battery now">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="PodsCheckIcon" Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                          </TextBlock>
                          <TextBlock x:Name="PodsCheckText" Text="Check now" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <UniformGrid Columns="3">
                    <StackPanel>
                      <Grid Width="136" Height="136">
                        <Canvas x:Name="PRingL" Width="136" Height="136"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock x:Name="PPctL" Text="100%" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                          <StackPanel x:Name="PChgL" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="PodBolt" Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Charging" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}" Margin="4,0,0,0"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Left" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel>
                      <Grid Width="136" Height="136">
                        <Canvas x:Name="PRingR" Width="136" Height="136"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock x:Name="PPctR" Text="--" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                          <StackPanel x:Name="PChgR" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Charging" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}" Margin="4,0,0,0"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Right" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel>
                      <Grid Width="136" Height="136">
                        <Canvas x:Name="PRingC" Width="136" Height="136"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock x:Name="PPctC" Text="--" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                          <StackPanel x:Name="PChgC" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Charging" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}" Margin="4,0,0,0"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Case" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
              </StackPanel>
              <Border x:Name="OtherPanel" Style="{StaticResource Card}" Padding="16,2,16,2" Visibility="Collapsed">
                <StackPanel x:Name="DeviceRows"/>
              </Border>
              <!-- nothing connected at all -->
              <Border x:Name="NoDevices" Style="{StaticResource Card}" Padding="24,26,24,26" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="48" Height="48" CornerRadius="24" Background="#0FFFFFFF" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE702;" Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="NoDevTitle" Text="Looking for devices..." Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                  <TextBlock Text="Connect headphones, a mouse, keyboard or controller over Bluetooth and its battery shows up here." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Options" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE81E;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Show in the overlay" Style="{StaticResource Body}"/>
                    <TextBlock Text="AirPods battery next to your game stats" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="DevOsd" Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE83F;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Low battery alert" Style="{StaticResource Body}"/>
                    <TextBlock Text="One Windows notification when a device reaches this level" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LowBatV" Text="25%" Style="{StaticResource Body}" VerticalAlignment="Center" Width="40" TextAlignment="Right" Margin="0,0,12,0"/>
                    <Slider x:Name="LowBat" Style="{StaticResource FluentSlider}" Width="150" Minimum="5" Maximum="50" Value="25" Margin="0,0,20,0" IsSnapToTickEnabled="True" TickFrequency="5"/>
                    <CheckBox x:Name="LowBatOn" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Check battery" Style="{StaticResource Body}"/>
                    <TextBlock Text="Background checks for low-battery alerts." Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ChkManual" GroupName="BatChk" Style="{StaticResource SegItem}" Content="Manual" Tag="0"/>
                      <RadioButton x:Name="Chk15" GroupName="BatChk" Style="{StaticResource SegItem}" Content="15 min" Tag="15"/>
                      <RadioButton x:Name="Chk30" GroupName="BatChk" Style="{StaticResource SegItem}" Content="30 min" Tag="30" IsChecked="True"/>
                      <RadioButton x:Name="Chk60" GroupName="BatChk" Style="{StaticResource SegItem}" Content="1 hour" Tag="60"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== OVERLAY ========================== -->
          <ScrollViewer x:Name="PageOverlay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Overlay" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Live stats on top of your games. Vento shows it on its own when a game starts." Style="{StaticResource Body}"
                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>
              <!-- A game-like scene with the overlay where it will sit -->
              <Border CornerRadius="8" Height="168" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" ClipToBounds="True" Background="{StaticResource SceneBrush}">
                <Grid>
                  <Ellipse Width="420" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-120" Opacity="0.55">
                    <Ellipse.Fill>
                      <RadialGradientBrush>
                        <GradientStop Color="#FFB46A" Offset="0"/>
                        <GradientStop Color="#00FFB46A" Offset="1"/>
                      </RadialGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Width="360" Height="220" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-90,0,0" Opacity="0.5">
                    <Ellipse.Fill>
                      <RadialGradientBrush>
                        <GradientStop Color="#5AA9FF" Offset="0"/>
                        <GradientStop Color="#005AA9FF" Offset="1"/>
                      </RadialGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Border x:Name="OsdMock" CornerRadius="8" Background="{DynamicResource OsdPanelBrush}" BorderBrush="{DynamicResource OsdBorderBrush}" BorderThickness="1"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="12,7">
                    <!-- built by app.ps1 from the metrics switched on below, with live values -->
                    <StackPanel x:Name="OsdItems" Orientation="Horizontal"/>
                  </Border>
                  <TextBlock Text="Preview" Style="{StaticResource Caption}" Foreground="#99FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,10"/>
                </Grid>
              </Border>

              <TextBlock Text="Layout" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <UniformGrid Columns="4" Margin="-4,0">
                <RadioButton x:Name="LayBlade" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8" Tag="blade">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" BorderBrush="{DynamicResource OsdAccentBrush}" BorderThickness="2,0,0,0" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,3">
                        <StackPanel>
                          <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="13" Foreground="{DynamicResource OsdAccentBrush}"/>
                          <TextBlock Text="60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}"/>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Blade" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayStrip" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8" Tag="strip">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="144" Style="{StaticResource OsdTiny}" Foreground="{DynamicResource OsdAccentBrush}"/>
                          <TextBlock Text="  60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}"/>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Strip" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayHero" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8" Tag="hero">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2,7,4">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="20" Foreground="{DynamicResource OsdAccentBrush}"/>
                            <TextBlock Text=" FPS" Style="{StaticResource OsdTiny}" FontSize="7" Foreground="{DynamicResource OsdLabBrush}" Margin="0,5,0,0"/>
                          </StackPanel>
                          <TextBlock Text="60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}" FontSize="7"/>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Hero" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayPills" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8" Tag="pills">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                        <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="7" Padding="6,1" Margin="0,0,3,0"><TextBlock Text="144" Style="{StaticResource OsdTiny}" Foreground="{DynamicResource OsdAccentBrush}"/></Border>
                        <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="7" Padding="6,1" Margin="0,0,3,0"><TextBlock Text="60&#xB0;" Style="{StaticResource OsdTiny}"/></Border>
                        <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="7" Padding="6,1"><TextBlock Text="54&#xB0;" Style="{StaticResource OsdTiny}"/></Border>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Pills" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayGhost" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,0" Tag="ghost">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,6">
                        <StackPanel.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.9"/></StackPanel.Effect>
                        <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="17" Foreground="{DynamicResource OsdAccentBrush}"/>
                        <TextBlock Text="60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Ghost" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayMicro" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,0" Tag="micro">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,7">
                        <StackPanel.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.9"/></StackPanel.Effect>
                        <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="7" Foreground="{DynamicResource OsdAccentBrush}"/>
                        <TextBlock Text="  60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}" FontSize="7"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Micro" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayThermo" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,0" Tag="thermo">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="5,4,8,4">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="3" CornerRadius="1.5" Margin="0,0,6,0">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#6FB1FF" Offset="0"/>
                                <GradientStop Color="#F5A45C" Offset="0.6"/>
                                <GradientStop Color="#F2606B" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <StackPanel>
                            <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="12" Foreground="{DynamicResource OsdAccentBrush}"/>
                            <TextBlock Text="60&#xB0;  54&#xB0;" Style="{StaticResource OsdTiny}"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Thermo" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>

              <TextBlock Text="What it shows" Style="{StaticResource BodyStrong}" Margin="0,20,0,2"/>
              <TextBlock Text="The first one switched on is the big number. Each can have its own color." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <!-- one row per metric (built by app.ps1): color dot, name, switch -->
              <Border Style="{StaticResource Card}" Padding="16,2,16,2">
                <UniformGrid x:Name="MetricRows" Columns="2"/>
              </Border>

              <TextBlock Text="Look" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Color" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="OsdThemeName" Text="Sirocco" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ThSirocco" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#6FB1FF" Tag="sirocco" ToolTip="Sirocco"/>
                    <RadioButton x:Name="ThEmber" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#FFB25C" Tag="ember" ToolTip="Ember"/>
                    <RadioButton x:Name="ThVenom" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#7CF29B" Tag="venom" ToolTip="Venom"/>
                    <RadioButton x:Name="ThViolet" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#B18CFF" Tag="violet" ToolTip="Violet"/>
                    <RadioButton x:Name="ThCrimson" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#FF6B7E" Tag="crimson" ToolTip="Crimson"/>
                    <RadioButton x:Name="ThMono" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#F2F4F7" Tag="mono" ToolTip="Mono"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Position" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="OsdCornerName" Text="Top right" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <!-- a tiny screen with a spot per corner -->
                  <Border Grid.Column="2" Width="84" Height="52" CornerRadius="5" BorderBrush="#5DFFFFFF" BorderThickness="1.5" Background="#0AFFFFFF">
                    <Grid Margin="3">
                      <RadioButton x:Name="CorTL" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="tl"/>
                      <RadioButton x:Name="CorTR" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="tr"/>
                      <RadioButton x:Name="CorBL" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Tag="bl"/>
                      <RadioButton x:Name="CorBR" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Tag="br"/>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE740;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Size" Style="{StaticResource Body}"/>
                    <TextBlock Text="Scales the whole overlay" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" x:Name="OsdScaleV" Text="100%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" x:Name="OsdScale" Style="{StaticResource FluentSlider}" Minimum="75" Maximum="200" Value="100" IsSnapToTickEnabled="True" TickFrequency="5"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Opacity" Style="{StaticResource Body}"/>
                    <TextBlock Text="Let a little of the game show through" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" x:Name="OsdOpacityV" Text="100%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" x:Name="OsdOpacity" Style="{StaticResource FluentSlider}" Minimum="30" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="5"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7C2;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Exact position" Style="{StaticResource Body}"/>
                    <TextBlock Text="Drag the overlay anywhere on screen, or snap it back to its corner" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OsdMove" Style="{StaticResource FluentButton}" Content="Move on screen" FontSize="13" MinHeight="30" Padding="12,4"/>
                    <Button x:Name="OsdResetPos" Style="{StaticResource FluentButton}" Content="Back to corner" FontSize="13" MinHeight="30" Padding="12,4" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Text="Behavior" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE81E;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Show overlay" Style="{StaticResource Body}"/>
                    <TextBlock Text="Auto appears with a game and hides after it" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="OmAuto" GroupName="OsdMode" Style="{StaticResource SegItem}" Content="Auto" Tag="auto"/>
                      <RadioButton x:Name="OmOn" GroupName="OsdMode" Style="{StaticResource SegItem}" Content="Always" Tag="on"/>
                      <RadioButton x:Name="OmOff" GroupName="OsdMode" Style="{StaticResource SegItem}" Content="Off" Tag="off"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7EF;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Hide from screen capture" Style="{StaticResource Body}"/>
                    <TextBlock Text="Invisible to OBS, Discord and screenshots" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="OsdCapSafe" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Show on the second display" Style="{StaticResource Body}"/>
                    <TextBlock Text="Keep the game screen completely clean" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="OsdSecond" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== SETTINGS ========================= -->
          <!-- Lights: the BLE LED strip. Shown only where it is switched on (HKCU), built by app.ps1 -->
          <ScrollViewer x:Name="PageLights" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Lights" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Your LED strip over Bluetooth. While Vento holds it the phone app can't connect; disconnect to hand it back." Style="{StaticResource Body}"
                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20" TextWrapping="Wrap"/>

              <!-- the strip as it should look right now, with the link controls -->
              <Border CornerRadius="8" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" ClipToBounds="True" Background="{StaticResource SceneBrush}">
                <Grid Height="150">
                  <Border x:Name="LedHalo" Height="70" CornerRadius="35" Margin="40,0" VerticalAlignment="Center" Opacity="0.55">
                    <Border.Effect><BlurEffect Radius="40"/></Border.Effect>
                  </Border>
                  <Border x:Name="LedBar" Height="12" CornerRadius="6" Margin="56,0" VerticalAlignment="Center" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0">
                    <Ellipse x:Name="LedDot" Width="8" Height="8" Fill="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LedState" Text="Not connected" Style="{StaticResource BodyStrong}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="LedNow" Text="" Style="{StaticResource Caption}" Foreground="#CCFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,12"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
                    <Button x:Name="LedConnect" Style="{StaticResource AccentButton}" Content="Connect" FontSize="13" MinHeight="30" Padding="16,4"/>
                  </StackPanel>
                  <TextBlock x:Name="LedErr" Text="" Style="{StaticResource Caption}" Foreground="#FF99A4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,14,12" MaxWidth="420" TextWrapping="Wrap" TextAlignment="Right"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,4">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE702;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Connect when Vento starts" Style="{StaticResource Body}"/>
                    <TextBlock Text="Needed for the schedule and the automatic modes; the phone app can't connect meanwhile" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="LedAutoConn" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>

              <!-- everything below needs the link; app.ps1 dims it while disconnected -->
              <StackPanel x:Name="LedControls">
                <TextBlock Text="Strip" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
                <Border Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock Text="Power" Style="{StaticResource Body}"/>
                      <TextBlock Text="The strip keeps its color and effect while off" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <CheckBox x:Name="LedPower" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock Text="Brightness" Style="{StaticResource Body}"/>
                    </StackPanel>
                    <Slider x:Name="LedBri" Grid.Column="2" Style="{StaticResource FluentSlider}" Minimum="1" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LedBriV" Grid.Column="3" Text="100%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <TextBlock Text="Color" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
                <Border Style="{StaticResource Card}" Padding="16,14">
                  <StackPanel>
                    <WrapPanel x:Name="LedSwatches" Margin="-4,0,0,0"/>
                    <Grid Margin="0,14,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Hue" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Slider x:Name="LedHue" Grid.Column="1" Style="{StaticResource HueSlider}" Minimum="0" Maximum="359" Value="240" IsSnapToTickEnabled="True" TickFrequency="1"/>
                      <Border x:Name="LedHuePrev" Grid.Column="2" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Saturation" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Slider x:Name="LedSat" Grid.Column="1" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="1"/>
                      <TextBlock x:Name="LedSatV" Grid.Column="2" Text="100%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Grid Margin="0,20,0,8">
                  <TextBlock Text="Effects" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                  <TextBlock Text="Built into the strip: they keep running after you disconnect" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Style="{StaticResource SettingsCard}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEC4A;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                      <TextBlock Text="Effect speed" Style="{StaticResource Body}"/>
                    </StackPanel>
                    <Slider x:Name="LedSpeed" Grid.Column="2" Style="{StaticResource FluentSlider}" Minimum="1" Maximum="100" Value="50" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LedSpeedV" Grid.Column="3" Text="50" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left" Margin="0,8,0,10">
                  <StackPanel x:Name="LedFilters" Orientation="Horizontal"/>
                </Border>
                <WrapPanel x:Name="LedEffects" Margin="-4,0"/>

                <Grid Margin="0,20,0,8">
                  <TextBlock Text="My color loops" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                  <Button x:Name="LedLoopNew" Style="{StaticResource FluentButton}" HorizontalAlignment="Right" FontSize="13" MinHeight="28" Padding="12,3">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                      <TextBlock Text="New loop" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
                <TextBlock Text="Only the colors you pick, in your order. Vento plays these, so it stays connected while one runs." Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel x:Name="LedLoops"/>
                <!-- inline editor for a new or existing loop -->
                <Border x:Name="LedLoopEdit" Style="{StaticResource Card}" Padding="16,14" Margin="0,4,0,0" Visibility="Collapsed">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Name" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <TextBox x:Name="LedLoopName" Grid.Column="1" Style="{StaticResource FluentTextBox}" MaxLength="24"/>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Colors" Style="{StaticResource Body}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                      <StackPanel Grid.Column="1">
                        <WrapPanel x:Name="LedLoopColors" MinHeight="34"/>
                        <TextBlock x:Name="LedLoopHint" Text="Click a color below to add it; click one here to take it out." Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <!-- the loop's own picker: a swatch adds at once, the hue row adds any other color -->
                        <WrapPanel x:Name="LedLoopPalette" Margin="-4,10,0,0"/>
                        <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Slider x:Name="LedLoopHue" Style="{StaticResource HueSlider}" Minimum="0" Maximum="359" Value="200" IsSnapToTickEnabled="True" TickFrequency="1"/>
                          <Button x:Name="LedLoopAddHue" Grid.Column="1" Style="{StaticResource FluentButton}" MinHeight="30" Padding="10,0" Margin="12,0,0,0" FontSize="13">
                            <StackPanel Orientation="Horizontal">
                              <Ellipse x:Name="LedLoopHueDot" Width="14" Height="14" VerticalAlignment="Center"/>
                              <TextBlock Text="Add" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Change" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Style="{StaticResource SegHost}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="LedTrFade" GroupName="LedTr" Style="{StaticResource SegItem}" Content="Fade" Tag="fade" IsChecked="True"/>
                          <RadioButton x:Name="LedTrDim" GroupName="LedTr" Style="{StaticResource SegItem}" Content="Dim" Tag="dim"/>
                          <RadioButton x:Name="LedTrJump" GroupName="LedTr" Style="{StaticResource SegItem}" Content="Jump" Tag="jump"/>
                          <RadioButton x:Name="LedTrBreathe" GroupName="LedTr" Style="{StaticResource SegItem}" Content="Breathe" Tag="breathe"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                      <TextBlock Text="Each color" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Slider x:Name="LedLoopSec" Grid.Column="1" Style="{StaticResource FluentSlider}" Minimum="1" Maximum="60" Value="6" IsSnapToTickEnabled="True" TickFrequency="1"/>
                      <TextBlock x:Name="LedLoopSecV" Grid.Column="2" Text="3 s" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                      <TextBlock x:Name="LedLoopErr" Text="" Style="{StaticResource Caption}" Foreground="#FF99A4" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="LedLoopCancel" Style="{StaticResource FluentButton}" Content="Cancel" FontSize="13" MinHeight="30" Padding="16,4" Margin="0,0,8,0"/>
                        <Button x:Name="LedLoopSave" Style="{StaticResource AccentButton}" Content="Save and play" FontSize="13" MinHeight="30" Padding="16,4"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Appearance" Style="{StaticResource BodyStrong}" Margin="0,22,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEB41;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Window material" Style="{StaticResource Body}"/>
                    <TextBlock Text="Mica matches Windows Settings and takes its tone from your theme; Acrylic shows what is behind" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="MatAcrylic" GroupName="Mat" Style="{StaticResource SegItem}" Content="Acrylic" Tag="3"/>
                      <RadioButton x:Name="MatMica" GroupName="Mat" Style="{StaticResource SegItem}" Content="Mica" Tag="2" IsChecked="True"/>
                      <RadioButton x:Name="MatMicaAlt" GroupName="Mat" Style="{StaticResource SegItem}" Content="Mica Alt" Tag="4"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Accent color" Style="{StaticResource Body}"/>
                    <TextBlock Text="Follows the accent you picked in Windows" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AccentHex" Text="#4CC2FF" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource AccentBrush}" BorderBrush="#24FFFFFF" BorderThickness="1"/>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock x:Name="ShortcutsTitle" Text="Shortcuts" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <!-- One card, a row per action (built by app.ps1). Record listens for the next combo. -->
              <Border Style="{StaticResource Card}" Padding="16,2,16,2">
                <StackPanel x:Name="HotkeyRows"/>
              </Border>

              <TextBlock Text="Startup" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" Style="{StaticResource Body}"/>
                    <TextBlock Text="Fans are under control from the moment you sign in" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="StartWin" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7C4;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Keep running in the tray" Style="{StaticResource Body}"/>
                    <TextBlock Text="Closing the window leaves fan control on" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="KeepTray" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE9F3;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Check for updates automatically" Style="{StaticResource Body}"/>
                    <TextBlock Text="Downloads are verified before they install" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="AutoUpd" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE73F;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Start in the tray" Style="{StaticResource Body}"/>
                    <TextBlock Text="Open quietly at sign-in without showing the window" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="StartMin" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE916;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Sensor refresh" Style="{StaticResource Body}"/>
                    <TextBlock Text="How often temperatures and fan speeds are read" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" x:Name="PollV" Text="2 s" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" x:Name="Poll" Style="{StaticResource FluentSlider}" Minimum="1" Maximum="10" Value="2" IsSnapToTickEnabled="True" TickFrequency="1"/>
                </Grid>
              </Border>

              <TextBlock Text="About" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}">
                    <Path Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Vento" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="AboutVersion" Text="Version" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="AboutUpdText" Style="{StaticResource Caption}" Visibility="Collapsed"/>
                  </StackPanel>
                  <Button x:Name="AboutUpdate" Grid.Column="2" Style="{StaticResource FluentButton}" Content="Check for updates" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Profile editor: a Windows 11 content dialog over a dimmed window -->
    <Grid x:Name="ProfileDialog" Visibility="Collapsed">
      <Border x:Name="ProfDlgBackdrop" Background="#99000000"/>
      <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
              Background="#2B2B2B" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5" Direction="270"/></Border.Effect>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="ProfDlgTitle" Text="New profile" Style="{StaticResource Subtitle}" FontSize="20"/>
            <TextBlock Text="Name" Style="{StaticResource Body}" Margin="0,18,0,6"/>
            <TextBox x:Name="ProfName" Style="{StaticResource FluentTextBox}" MaxLength="24"/>
            <TextBlock x:Name="ProfErr" Style="{StaticResource Caption}" Foreground="#FF99A4" Margin="0,6,0,0" Visibility="Collapsed"/>
            <TextBlock Text="Color" Style="{StaticResource Body}" Margin="0,16,0,8"/>
            <WrapPanel x:Name="ProfColors"/>
            <TextBlock Text="Fans" Style="{StaticResource Body}" Margin="0,10,0,8"/>
            <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PfQuiet" GroupName="PfFan" Style="{StaticResource SegItem}" Content="Quiet" Tag="quiet"/>
                <RadioButton x:Name="PfNormal" GroupName="PfFan" Style="{StaticResource SegItem}" Content="Normal" Tag="normal"/>
                <RadioButton x:Name="PfPerf" GroupName="PfFan" Style="{StaticResource SegItem}" Content="Performance" Tag="performance"/>
                <RadioButton x:Name="PfCurve" GroupName="PfFan" Style="{StaticResource SegItem}" Content="Curve" Tag="curve"/>
                <RadioButton x:Name="PfAuto" GroupName="PfFan" Style="{StaticResource SegItem}" Content="Auto" Tag="auto"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Overlay" Style="{StaticResource Body}" Margin="0,16,0,8"/>
            <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PoOn" GroupName="PfOsd" Style="{StaticResource SegItem}" Content="On" Tag="on"/>
                <RadioButton x:Name="PoOff" GroupName="PfOsd" Style="{StaticResource SegItem}" Content="Off" Tag="off"/>
                <RadioButton x:Name="PoAuto" GroupName="PfOsd" Style="{StaticResource SegItem}" Content="While gaming" Tag="auto"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Displays" Style="{StaticResource Body}" Margin="0,16,0,8"/>
            <Border Style="{StaticResource SegHost}" HorizontalAlignment="Left">
              <WrapPanel x:Name="ProfDisplays"/>
            </Border>
          </StackPanel>
          <!-- footer band, like a ContentDialog -->
          <Border Grid.Row="1" Background="#202020" CornerRadius="0,0,8,8" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="24,20">
            <Grid>
              <Button x:Name="ProfDelete" Style="{StaticResource FluentButton}" Content="Delete" HorizontalAlignment="Left" MinWidth="96" Foreground="#FF99A4"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ProfSave" Style="{StaticResource AccentButton}" Content="Save" MinWidth="110" IsDefault="True"/>
                <Button x:Name="ProfCancel" Style="{StaticResource FluentButton}" Content="Cancel" MinWidth="110" Margin="8,0,0,0" IsCancel="True"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- New display preset: a name and a color; levels come from the displays -->
    <Grid x:Name="PresetDialog" Visibility="Collapsed">
      <Border x:Name="PresetBackdrop" Background="#99000000"/>
      <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
              Background="#2B2B2B" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5" Direction="270"/></Border.Effect>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="24,22,24,20">
            <TextBlock Text="New display preset" Style="{StaticResource Subtitle}" FontSize="20"/>
            <TextBlock Text="Saves the brightness, contrast and color the first display has right now." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="Name" Style="{StaticResource Body}" Margin="0,16,0,6"/>
            <TextBox x:Name="PresetName" Style="{StaticResource FluentTextBox}" MaxLength="16"/>
            <TextBlock x:Name="PresetErr" Style="{StaticResource Caption}" Foreground="#FF99A4" Margin="0,6,0,0" Visibility="Collapsed"/>
            <TextBlock Text="Color" Style="{StaticResource Body}" Margin="0,16,0,8"/>
            <WrapPanel x:Name="PresetColors"/>
          </StackPanel>
          <Border Grid.Row="1" Background="#202020" CornerRadius="0,0,8,8" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="24,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="PresetSave" Style="{StaticResource AccentButton}" Content="Save" MinWidth="110" IsDefault="True"/>
              <Button x:Name="PresetCancel" Style="{StaticResource FluentButton}" Content="Cancel" MinWidth="110" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
