<!--
  Vento - "Glass" theme (preview only, not wired into the app).

  Windows 11 Fluent, dark: real DWM acrylic / Mica behind the window, Segoe
  UI Variable type, Segoe Fluent Icons, and the user's own Windows accent.
  Tokens follow WinUI's dark theme resources (TextFillColor*, CardBackground*,
  ControlStrongFill...) so the app reads as native next to Settings.

  Placeholders filled at load by Glass.ps1:
    __ACCENT__        accent fill  (Windows accent "Light 2")
    __ACCENTLIGHT__   accent text  (Windows accent "Light 3")
    __ACCENTSOFT__    accent fill at ~14% for selected surfaces
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Segoe UI, not Segoe UI Variable: WPF can't apply a variable font's
       weight axis, so the Variable faces come out mis-weighted. The static
       Segoe UI faces are what Windows draws its own UI text with. -->
  <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>
  <FontFamily x:Key="TextFont">Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Accent (from Windows) -->
  <Color x:Key="AccentColor">__ACCENT__</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="__ACCENT__"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="__ACCENTLIGHT__"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="__ACCENTSOFT__"/>
  <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000"/>

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF"/>

  <!-- Surfaces -->
  <!-- Settings-app look: the page sits straight on Mica, no extra sheet tone -->
  <SolidColorBrush x:Key="LayerBrush" Color="#00000000"/>
  <SolidColorBrush x:Key="LayerStrokeBrush" Color="#00000000"/>
  <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF"/>
  <SolidColorBrush x:Key="CardHoverBrush" Color="#15FFFFFF"/>
  <LinearGradientBrush x:Key="CardStrokeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#17FFFFFF" Offset="0"/>
    <GradientStop Color="#0CFFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF"/>
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#15FFFFFF"/>
  <LinearGradientBrush x:Key="ControlStrokeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#18FFFFFF" Offset="0"/>
    <GradientStop Color="#12FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="StrongFillBrush" Color="#8BFFFFFF"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
  <SolidColorBrush x:Key="WarmBrush" Color="#FFB547"/>
  <SolidColorBrush x:Key="HotBrush" Color="#FF8A80"/>

  <!-- Line icons on a 24px grid, stroked 1.5 like Segoe Fluent Icons.
       Fan: four swept blades in a ring. The 16px variant drops the ring and
       opens the blades up so it stays legible. Auto: the turn-around arrows
       of "automatic" with an A at the center. -->
  <Geometry x:Key="FanGeometry">M8.08 6.88A4.07 4.07 0 0 1 11.98 4a4 4 0 1 1 .03 8H2.74a.75.75 0 0 1 0-1.5H12a2.5 2.5 0 1 0-.03-5c-1.13 0-2.13.74-2.46 1.82l-.04.15a.75.75 0 1 1-1.44-.44l.05-.15Zm8.2 5.13a2.93 2.93 0 0 1 5.71.92V13a3 3 0 0 1-2.99 3h-1.3a2.75 2.75 0 0 1-2.45 4h-.13c-.97 0-1.86-.55-2.29-1.41a.75.75 0 0 1 1.34-.67c.18.35.55.58.95.58h.13a1.25 1.25 0 1 0 0-2.5H2.75a.75.75 0 0 1 0-1.5H19c.83 0 1.5-.67 1.5-1.5v-.07a1.43 1.43 0 0 0-2.79-.44.75.75 0 0 1-1.42-.48Z</Geometry>
  <Geometry x:Key="FanGeometrySmall">M8.08 6.88A4.07 4.07 0 0 1 11.98 4a4 4 0 1 1 .03 8H2.74a.75.75 0 0 1 0-1.5H12a2.5 2.5 0 1 0-.03-5c-1.13 0-2.13.74-2.46 1.82l-.04.15a.75.75 0 1 1-1.44-.44l.05-.15Zm8.2 5.13a2.93 2.93 0 0 1 5.71.92V13a3 3 0 0 1-2.99 3h-1.3a2.75 2.75 0 0 1-2.45 4h-.13c-.97 0-1.86-.55-2.29-1.41a.75.75 0 0 1 1.34-.67c.18.35.55.58.95.58h.13a1.25 1.25 0 1 0 0-2.5H2.75a.75.75 0 0 1 0-1.5H19c.83 0 1.5-.67 1.5-1.5v-.07a1.43 1.43 0 0 0-2.79-.44.75.75 0 0 1-1.42-.48Z</Geometry>
  <Geometry x:Key="AutoGeometry">M3.5 12a8.5 8.5 0 1 1 17 0 8.5 8.5 0 0 1-17 0ZM12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm5.5 6.25a.75.75 0 0 0-1.5 0V9a5 5 0 0 0-7.81-.24.75.75 0 1 0 1.14.97 3.5 3.5 0 0 1 5.83.77h-1.41a.75.75 0 0 0 0 1.5h3c.41 0 .75-.34.75-.75v-3ZM7.25 16.5a.75.75 0 0 1-.75-.75v-3c0-.41.34-.75.75-.75h3a.75.75 0 0 1 0 1.5H8.84a3.5 3.5 0 0 0 5.83.77.75.75 0 0 1 1.14.97A5 5 0 0 1 8 15v.75c0 .41-.34.75-.75.75Z</Geometry>
  <!-- Filled glyphs from Microsoft Fluent UI System Icons (MIT): fan/airflow = weather_squalls, auto = arrow_sync_circle -->
  <Style x:Key="FluentIcon" TargetType="Path">
    <Setter Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
  </Style>
  <Style x:Key="LineIcon" TargetType="Path">
    <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
  </Style>

  <!-- Search box, as at the top of the Settings pane -->
  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="4" Background="#0FFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
            <Grid>
              <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Background="#8BFFFFFF" Margin="1,0"/>
              <TextBlock x:Name="Hint" Text="Find a setting" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="12,0,36,1" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="9,0,36,0" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#B31E1E1E"/>
              <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Line" Property="Height" Value="2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Type ramp (WinUI: Caption 12 / Body 14 / BodyStrong 14 / Subtitle 20 / Title 28) -->
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="CaptionTertiary" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Subtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
    <Setter Property="FontSize" Value="28"/>
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <!-- One row of a Settings-style list: icon | title + description | control -->
  <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="16,12,16,12"/>
    <Setter Property="MinHeight" Value="68"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <Style x:Key="IconTile" TargetType="Border">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="#0FFFFFFF"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Navigation item: subtle fill + accent pill when selected -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <!-- the accent pill is one shared element that slides between
               items (Glass.ps1), like NavigationView's selection indicator -->
          <Grid Background="Transparent">
            <Border x:Name="Bd" CornerRadius="4" Background="Transparent"/>
            <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fan mode picker: a card per mode, like Windows' power-mode tiles -->
  <Style x:Key="ModeCard" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Padding" Value="14,12,12,12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter/>
              <Border x:Name="Tick" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#000000"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control item -->
  <Style x:Key="SegItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Bar" Width="16" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegHost" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ControlFillBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ToggleSwitch (a CheckBox), with the On/Off label Windows shows -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="Lbl" Text="Off" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Grid Width="40" Height="20">
              <Border x:Name="Track" CornerRadius="10" Background="Transparent" BorderBrush="#9AFFFFFF" BorderThickness="1"/>
              <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#CDFFFFFF" HorizontalAlignment="Left" Margin="4,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobT"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#0FFFFFFF"/>
              <Setter TargetName="Knob" Property="Width" Value="14"/>
              <Setter TargetName="Knob" Property="Height" Value="14"/>
            </Trigger>
            <!-- the knob slides instead of jumping -->
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                      <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
              <Setter TargetName="Lbl" Property="Text" Value="On"/>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Knob" Property="Fill" Value="#000000"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slider: 4px rail, accent fill, the ringed Windows 11 thumb -->
  <Style x:Key="SliderFillRB" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderGapRB" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="20" Height="20" Background="Transparent">
            <Ellipse Fill="#454545" Stroke="#23FFFFFF" StrokeThickness="1"/>
            <Ellipse x:Name="Core" Width="12" Height="12" Fill="{DynamicResource AccentBrush}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Core" Property="Width" Value="14"/>
              <Setter TargetName="Core" Property="Height" Value="14"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Core" Property="Width" Value="10"/>
              <Setter TargetName="Core" Property="Height" Value="10"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentSlider" TargetType="Slider">
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="24" Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="{StaticResource StrongFillBrush}" VerticalAlignment="Center" Margin="2,0"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillRB}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderGapRB}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource FluentThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons -->
  <Style x:Key="FluentButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource ControlFillBrush}" BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF"/>
              <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource AccentBrush}" BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Keycap" TargetType="Border">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="#0FFFFFFF"/>
    <Setter Property="BorderBrush" Value="#24FFFFFF"/>
    <Setter Property="BorderThickness" Value="1,1,1,2"/>
    <Setter Property="Padding" Value="8,2,8,3"/>
    <Setter Property="Margin" Value="4,0,0,0"/>
  </Style>

  <!-- Borderless icon button (InfoBar close, flyout footer) -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Hyperlink-style button -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="8,4">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Profile chip: colored dot + name, accent ring when active -->
  <Style x:Key="ProfileChip" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" CornerRadius="15" Background="{StaticResource ControlFillBrush}" BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1" Padding="10,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{TemplateBinding Background}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Color swatch: fill comes from Background, a white ring marks the pick -->
  <Style x:Key="Swatch" TargetType="RadioButton">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="4,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
            <Ellipse Width="22" Height="22" Fill="{TemplateBinding Background}" Stroke="#24FFFFFF" StrokeThickness="1"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="#5DFFFFFF"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Corner picker dot -->
  <Style x:Key="CornerDot" TargetType="RadioButton">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Dot" Width="14" Height="9" CornerRadius="2" Background="#33FFFFFF"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="Background" Value="#66FFFFFF"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Quick Settings tile (tray flyout): accent fill when on -->
  <Style x:Key="QuickTile" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Height" Value="48"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" CornerRadius="6" Background="{StaticResource ControlFillBrush}" BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="Foreground" Value="#000000"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim overlay scrollbar -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Width="4" CornerRadius="2" Background="#5DFFFFFF" HorizontalAlignment="Center"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="#2C2C2C"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#33000000"/>
    <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,5"/>
  </Style>
</ResourceDictionary>
