<!--
  Vento rebuilt as a Windows 11 app: real glass behind the window (DWM
  acrylic / Mica, applied by Glass.ps1), a Settings-style navigation pane and
  one page per area instead of a single tall dashboard with overlays.
  Preview only - fake sensor data, nothing here talks to hardware.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vento" Width="1120" Height="868" MinWidth="1000" MinHeight="640"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontFamily="{StaticResource TextFont}" Foreground="{StaticResource TextPrimaryBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="48" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Overlay theme in use; Glass.ps1 swaps these when a color is picked -->
    <SolidColorBrush x:Key="OsdAccentBrush" Color="#6FB1FF"/>
    <SolidColorBrush x:Key="OsdPanelBrush" Color="#DC0A0D13"/>
    <SolidColorBrush x:Key="OsdBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="OsdInkBrush" Color="#EDF1F8"/>
    <SolidColorBrush x:Key="OsdLabBrush" Color="#8FA3BC"/>
    <LinearGradientBrush x:Key="SceneBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1B2A3A" Offset="0"/>
      <GradientStop Color="#3A2533" Offset="0.55"/>
      <GradientStop Color="#4A3020" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="MiniScene" TargetType="Border">
      <Setter Property="Height" Value="70"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Background" Value="{StaticResource SceneBrush}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style x:Key="OsdTiny" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="8"/>
      <Setter Property="Foreground" Value="{DynamicResource OsdInkBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <!-- Deepens acrylic a touch so text keeps its contrast; Mica needs none -->
    <Border x:Name="Tint" Background="#59101216"/>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Title bar (drag area; the caption buttons are Windows' own) -->
      <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Image Source="__LOGO__vento-32.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Vento" Style="{StaticResource Caption}" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        <Border CornerRadius="4" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="6,0,6,1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Design preview" Style="{StaticResource CaptionTertiary}" FontSize="11"/>
        </Border>
        <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        <TextBlock Text="Live" Style="{StaticResource CaptionTertiary}" Margin="7,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <Button x:Name="BtnFlyout" Grid.ColumnSpan="2" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
              Margin="0,0,150,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="What Vento shows when you click its tray icon">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Tray flyout" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <!-- Navigation pane, laid out like the Settings app: account-style
           card, "Find a setting" search, then one flat list of pages -->
      <Grid x:Name="NavGrid" Grid.Row="1" Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="16,2,16,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- the app logo stands in for the account picture -->
          <Image x:Name="AvatarFan" Source="__LOGO__vento-128.png" Width="72" Height="72" Margin="-4" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="PcName" Text="This PC" Style="{StaticResource BodyStrong}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="ASUS B450M-DRAGON" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
        <TextBox x:Name="Search" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="16,0,16,14"/>

        <StackPanel Grid.Row="2" Margin="8,0,8,0">
          <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True" Tag="PageHome">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Home" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavFans" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageFans">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16"><Path Data="{StaticResource FanGeometrySmall}" Style="{StaticResource FluentIcon}" Fill="{StaticResource TextPrimaryBrush}"/></Viewbox>
              <TextBlock Text="Fans" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavAlerts" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageAlerts">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Alerts" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavProfiles" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageProfiles">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77B;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Profiles" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavDisplays" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageDisplays">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Displays" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavPods" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PagePods">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE702;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Devices" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavOverlay" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageOverlay">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81E;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Overlay" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}" Tag="PageSettings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Settings" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <!-- One selection pill for the whole pane; it slides to the picked item -->
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False">
          <Border x:Name="NavPill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource AccentBrush}">
            <Border.RenderTransform><TranslateTransform x:Name="NavPillT"/></Border.RenderTransform>
          </Border>
        </Canvas>
      </Grid>

      <!-- Content sheet -->
      <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource LayerStrokeBrush}"
              BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
        <Grid x:Name="Pages">

          <!-- ============================ HOME ============================ -->
          <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <Grid>
                <StackPanel>
                  <TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
                  <TextBlock x:Name="HomeStatus" Text="All quiet. The board is 3&#xB0; under its target." Style="{StaticResource Body}"
                             Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <TextBlock Text="Profile" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <RadioButton x:Name="ChipGaming" GroupName="HomeProfile" Style="{StaticResource ProfileChip}" Background="#7FE0A0" Content="Gaming" Tag="Gaming"/>
                  <RadioButton x:Name="ChipMovie" GroupName="HomeProfile" Style="{StaticResource ProfileChip}" Background="#FF7A8A" Content="Movie" Tag="Movie"/>
                  <RadioButton x:Name="ChipWork" GroupName="HomeProfile" Style="{StaticResource ProfileChip}" Background="#FFC46F" Content="Work" Tag="Work"/>
                </StackPanel>
              </Grid>

              <!-- Error InfoBar: the fan driver (PawnIO) is missing or stopped.
                   Shown instead of letting fan control fail silently. -->
              <Border x:Name="DriverBar" CornerRadius="4" Background="#442E1F22" BorderBrush="#33FF99A4" BorderThickness="1" Padding="14,10,8,10" Margin="0,20,0,0" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="18" Height="18" CornerRadius="9" Background="#FF99A4" VerticalAlignment="Top" Margin="0,1,0,0">
                    <TextBlock Text="!" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="Fan control is paused" Style="{StaticResource BodyStrong}"/>
                    <TextBlock Text="Vento can't reach the fan controller: the PawnIO driver is missing or stopped. Your fans are running on their BIOS settings until it is back." Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DriverFix" Style="{StaticResource AccentButton}" Content="Install driver" FontSize="13" MinHeight="28" Padding="12,3"/>
                    <Button x:Name="DriverClose" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="Dismiss"/>
                  </StackPanel>
                </Grid>
              </Border>
              <!-- InfoBar: an update that is downloaded and verified -->
              <Border x:Name="InfoBar" CornerRadius="4" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="14,8,8,8" Margin="0,20,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="InfoIconBg" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="InfoIcon" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="InfoTitle" Text="Vento 1.8.0 is ready" Style="{StaticResource BodyStrong}"/>
                    <TextBlock x:Name="InfoMsg" Text="Downloaded and verified. Restart to finish updating." Style="{StaticResource Body}" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0"/>
                  </StackPanel>
                  <Button x:Name="InfoRestart" Grid.Column="2" Style="{StaticResource AccentButton}" Content="Restart now" FontSize="13" MinHeight="28" Padding="12,3" Margin="12,0,6,0"/>
                  <Button x:Name="InfoClose" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Dismiss"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Height="208" Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- thermal glow: follows the board's state -->
                  <Border Grid.ColumnSpan="2" CornerRadius="8" IsHitTestVisible="False">
                    <Border.Background>
                      <RadialGradientBrush Center="0.1,0.3" GradientOrigin="0.1,0.3" RadiusX="0.5" RadiusY="1.2">
                        <GradientStop x:Name="HeroGlowStop" Color="#2A4CC2FF" Offset="0"/>
                        <GradientStop x:Name="HeroGlowEnd" Color="#004CC2FF" Offset="1"/>
                      </RadialGradientBrush>
                    </Border.Background>
                  </Border>
                  <StackPanel Margin="24,20,8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE9CA;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                      <TextBlock Text="Board temperature" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="HeroTempHost" Orientation="Horizontal" Background="Transparent" Cursor="Hand" HorizontalAlignment="Left"
                                ToolTip="Click to preview the warm and hot states">
                      <TextBlock x:Name="HeroTemp" Text="59" FontFamily="Segoe UI" FontSize="60" FontWeight="SemiBold"
                                 Typography.NumeralAlignment="Tabular" TextOptions.TextFormattingMode="Ideal" Margin="0,0,0,2"/>
                      <TextBlock Text="&#xB0;C" FontFamily="Segoe UI" FontSize="24" FontWeight="Normal"
                                 Foreground="{StaticResource TextSecondaryBrush}" Margin="6,14,0,0"/>
                    </StackPanel>
                    <Border x:Name="HeroChip" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left" Padding="10,3,10,4" Margin="0,-2,0,16">
                      <TextBlock x:Name="HeroChipText" Text="Nearing target &#xB7; 3&#xB0; below" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextBrush}"/>
                    </Border>
                    <!-- Headroom: where the board sits between idle and alarm -->
                    <Grid x:Name="MeterHost" Height="32">
                      <Border Height="6" CornerRadius="3" VerticalAlignment="Top" Margin="0,5,0,0" Opacity="0.9">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop x:Name="MeterStop0" Color="__ACCENT__" Offset="0"/>
                            <GradientStop x:Name="MeterStop1" Color="__ACCENT__" Offset="0.45"/>
                            <GradientStop Color="#FFB547" Offset="0.72"/>
                            <GradientStop Color="#FF8A80" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                      <Canvas x:Name="MeterMarks"/>
                      <TextBlock Text="40&#xB0;" Style="{StaticResource CaptionTertiary}" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                      <TextBlock Text="85&#xB0;" Style="{StaticResource CaptionTertiary}" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                    </Grid>
                  </StackPanel>
                  <Grid Grid.Column="1" Margin="8,18,22,18">
                    <TextBlock Text="Last 10 minutes" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Canvas x:Name="HeroChart" Margin="0,26,0,0"/>
                  </Grid>
                </Grid>
              </Border>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14,16,14">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Text="Sensors" Style="{StaticResource BodyStrong}"/>
                      <TextBlock Text="&#xB0;C" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE950;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock Text="Ryzen 5 3600" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" x:Name="TCpu" Text="60&#xB0;" Style="{StaticResource Metric}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xF211;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="GPU" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock Text="RTX 2060 SUPER" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" x:Name="TGpu" Text="54&#xB0;" Style="{StaticResource Metric}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="SSD" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock Text="Samsung 980 PRO 1TB" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" x:Name="TSsd" Text="42&#xB0;" Style="{StaticResource Metric}" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14,16,14">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Text="Fans" Style="{StaticResource BodyStrong}"/>
                      <TextBlock x:Name="HomeFansMode" Text="Quiet" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}">
                        <Path x:Name="SpinCpu" Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="CPU fan" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock x:Name="DutyCpu" Text="62% duty" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="RCpu" Text="1951" Style="{StaticResource Metric}"/>
                        <TextBlock Text="rpm" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}">
                        <Path x:Name="SpinCase" Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Case fans" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock x:Name="DutyCase" Text="30% duty" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="RCase" Text="717" Style="{StaticResource Metric}"/>
                        <TextBlock Text="rpm" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}">
                        <Path x:Name="SpinGpu" Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                        </Path>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="GPU fans" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock Text="33% duty" Style="{StaticResource Caption}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="RGpu" Text="1018" Style="{StaticResource Metric}"/>
                        <TextBlock Text="rpm" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14,16,14">
                  <StackPanel>
                    <Grid Margin="0,0,0,4">
                      <TextBlock Text="Devices" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                      <!-- page through: one battery page per device, then the list -->
                      <StackPanel x:Name="DevPager" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-6,-8,-6">
                        <TextBlock x:Name="DevPageText" Text="1 / 2" Style="{StaticResource CaptionTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="DevPrev" Style="{StaticResource IconButton}" Content="&#xE76B;" Width="28" Height="28" FontSize="11" ToolTip="Previous"/>
                        <Button x:Name="DevNext" Style="{StaticResource IconButton}" Content="&#xE76C;" Width="28" Height="28" FontSize="11" ToolTip="Next"/>
                      </StackPanel>
                    </Grid>
                    <!-- connected wireless devices and their battery, filled by Glass.ps1 -->
                    <Grid x:Name="HomeDevHost" Height="146" ClipToBounds="True"><StackPanel x:Name="HomeDevices"/></Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,14,12,12">
                <StackPanel>
                  <Grid Margin="4,0,4,12">
                    <TextBlock Text="Fan mode" Style="{StaticResource BodyStrong}"/>
                    <TextBlock Text="Applies instantly" Style="{StaticResource CaptionTertiary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                  <UniformGrid Columns="5">
                    <RadioButton x:Name="MQuiet" GroupName="HomeMode" Style="{StaticResource ModeCard}" IsChecked="True" Tag="Quiet">
                      <StackPanel>
                        <TextBlock Text="&#xF1E8;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Quiet" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Silent until warm" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MNormal" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Normal">
                      <StackPanel>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Normal" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Balanced every day" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MPerf" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Perf">
                      <StackPanel>
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Performance" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Airflow first" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MCurve" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Curve">
                      <StackPanel>
                        <TextBlock Text="&#xE9E9;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Curve" Style="{StaticResource BodyStrong}" Margin="0,10,0,0"/>
                        <TextBlock Text="Your own fan curve" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MAuto" GroupName="HomeMode" Style="{StaticResource ModeCard}" Tag="Auto">
                      <StackPanel>
