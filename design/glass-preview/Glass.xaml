                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="PresetDay" GroupName="Preset" Style="{StaticResource SegItem}" Content="Day" IsChecked="True" Tag="70,50,55,70"/>
                      <RadioButton x:Name="PresetGame" GroupName="Preset" Style="{StaticResource SegItem}" Content="Game" Tag="90,60,80,75"/>
                      <RadioButton x:Name="PresetCinema" GroupName="Preset" Style="{StaticResource SegItem}" Content="Cinema" Tag="35,45,30,60"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,18,20,18">
                  <StackPanel>
                    <Grid Margin="0,0,0,18">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="8">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Mon1Name" Text="XG2705" Style="{StaticResource BodyStrong}"/>
                        <TextBlock x:Name="Mon1Info" Text="Primary display" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE9A9;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextSecondaryBrush}"/>
                      <TextBlock Grid.Column="1" Text="Brightness" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Slider Grid.Column="2" x:Name="B1" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" Value="70"/>
                      <TextBlock Grid.Column="3" x:Name="B1V" Text="70" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextSecondaryBrush}"/>
                      <TextBlock Grid.Column="1" Text="Contrast" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Slider Grid.Column="2" x:Name="C1" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" Value="50"/>
                      <TextBlock Grid.Column="3" x:Name="C1V" Text="50" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                      <TextBlock Text="Input" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="28,0,0,0"/>
                      <Border Style="{StaticResource SegHost}">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton GroupName="In1" Style="{StaticResource SegItem}" Content="HDMI 1" IsChecked="True"/>
                          <RadioButton GroupName="In1" Style="{StaticResource SegItem}" Content="HDMI 2"/>
                          <RadioButton GroupName="In1" Style="{StaticResource SegItem}" Content="DP"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18,20,18">
                  <StackPanel>
                    <Grid Margin="0,0,0,18">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource IconTile}" Width="48" Height="48" CornerRadius="8">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Mon2Name" Text="LG ULTRAWIDE" Style="{StaticResource BodyStrong}"/>
                        <TextBlock x:Name="Mon2Info" Text="Second display" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE9A9;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextSecondaryBrush}"/>
                      <TextBlock Grid.Column="1" Text="Brightness" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Slider Grid.Column="2" x:Name="B2" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" Value="55"/>
                      <TextBlock Grid.Column="3" x:Name="B2V" Text="55" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextSecondaryBrush}"/>
                      <TextBlock Grid.Column="1" Text="Contrast" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      <Slider Grid.Column="2" x:Name="C2" Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" Value="70"/>
                      <TextBlock Grid.Column="3" x:Name="C2V" Text="70" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                      <TextBlock Text="Input" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="28,0,0,0"/>
                      <Border Style="{StaticResource SegHost}">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton GroupName="In2" Style="{StaticResource SegItem}" Content="HDMI"/>
                          <RadioButton GroupName="In2" Style="{StaticResource SegItem}" Content="DP" IsChecked="True"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>

              <TextBlock Text="All displays" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE9A9;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Match brightness" Style="{StaticResource Body}"/>
                    <TextBlock Text="Move one slider and the other display follows" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Night profile" Style="{StaticResource Body}"/>
                    <TextBlock Text="Dims both displays from 23:00 to 07:00" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== AIRPODS ========================== -->
          <ScrollViewer x:Name="PagePods" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Devices" Style="{StaticResource PageTitle}"/>
              <Grid Margin="0,4,0,20">
                <TextBlock Text="Battery for headphones, mice, keyboards and controllers." Style="{StaticResource Body}"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,330,0" TextTrimming="CharacterEllipsis"/>
                <!-- battery is read on a schedule, not constantly: when it was, and a button to look now -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="DevChecked" Text="Checking..." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="DevRefresh" Style="{StaticResource FluentButton}" FontSize="13" MinHeight="30" Padding="10,4" ToolTip="Check battery now">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <!-- Two tabs: AirPods (only while a pair is connected) and every
                   other connected device. Paired-but-away devices never show. -->
              <Border x:Name="DevTabs" Style="{StaticResource SegHost}" HorizontalAlignment="Left" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TabPods" GroupName="DevTab" Style="{StaticResource SegItem}" Content="AirPods" IsChecked="True"/>
                  <RadioButton x:Name="TabOther" GroupName="DevTab" Style="{StaticResource SegItem}" Content="Other devices"/>
                </StackPanel>
              </Border>
              <StackPanel x:Name="PodsPanel">
              <Border Style="{StaticResource Card}" Padding="28,22,28,26">
                <StackPanel>
                  <Grid Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal">
                      <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="22">
                        <TextBlock Text="&#xE7F6;" Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PodName" Text="AirPods" Style="{StaticResource Subtitle}" FontSize="18"/>
                        <TextBlock Text="AirPods 4 &#xB7; Connected" Style="{StaticResource Caption}"/>
                      </StackPanel>
                    </StackPanel>
                    <!-- on-demand read: listen for the AirPods' battery broadcast right now -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock x:Name="PodsUpdated" Text="Updated 12 min ago" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <Button x:Name="PodsCheck" Style="{StaticResource FluentButton}" FontSize="13" MinHeight="30" Padding="10,4" ToolTip="Read the battery now">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock x:Name="PodsCheckIcon" Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                          </TextBlock>
                          <TextBlock x:Name="PodsCheckText" Text="Check now" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <UniformGrid Columns="3">
                    <StackPanel>
                      <Grid Width="136" Height="136">
                        <Canvas x:Name="PRingL" Width="136" Height="136"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock x:Name="PPctL" Text="100%" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="PodBolt" Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Charging" Style="{StaticResource Caption}" Foreground="{StaticResource SuccessBrush}" Margin="4,0,0,0"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Left" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel>
                      <Grid Width="136" Height="136">
                        <Canvas x:Name="PRingR" Width="136" Height="136"/>
                        <TextBlock x:Name="PPctR" Text="90%" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Text="Right" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel>
                      <Grid Width="136" Height="136">
                        <Canvas x:Name="PRingC" Width="136" Height="136"/>
                        <TextBlock x:Name="PPctC" Text="30%" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock Text="Case" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
              </StackPanel>
              <Border x:Name="OtherPanel" Style="{StaticResource Card}" Padding="16,2,16,2" Visibility="Collapsed">
                <StackPanel x:Name="DeviceRows"/>
              </Border>
              <!-- nothing connected at all -->
              <Border x:Name="NoDevices" Style="{StaticResource Card}" Padding="24,26,24,26" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="48" Height="48" CornerRadius="24" Background="#0FFFFFFF" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE702;" Style="{StaticResource Glyph}" FontSize="20" HorizontalAlignment="Center"/>
                  </Border>
                  <TextBlock x:Name="NoDevTitle" Text="Looking for devices..." Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                  <TextBlock Text="Connect your AirPods, a headset, mouse or keyboard and its battery shows up here." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                  <Button x:Name="DevExample" Style="{StaticResource LinkButton}" Content="Preview with example devices" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Options" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE81E;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Show in the overlay" Style="{StaticResource Body}"/>
                    <TextBlock Text="Headphone battery next to your game stats" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE83F;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Low battery alert" Style="{StaticResource Body}"/>
                    <TextBlock Text="One Windows notification when a device reaches this level" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LowBatV" Text="25%" Style="{StaticResource Body}" VerticalAlignment="Center" Width="40" TextAlignment="Right" Margin="0,0,12,0"/>
                    <Slider x:Name="LowBat" Style="{StaticResource FluentSlider}" Width="150" Minimum="5" Maximum="50" Value="25" Margin="0,0,20,0"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Check battery" Style="{StaticResource Body}"/>
                    <TextBlock Text="Less often saves charge. Manual: only when you press Refresh." Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="ChkManual" GroupName="BatChk" Style="{StaticResource SegItem}" Content="Manual" Tag="0"/>
                      <RadioButton x:Name="Chk15" GroupName="BatChk" Style="{StaticResource SegItem}" Content="15 min" Tag="15"/>
                      <RadioButton x:Name="Chk30" GroupName="BatChk" Style="{StaticResource SegItem}" Content="30 min" Tag="30" IsChecked="True"/>
                      <RadioButton x:Name="Chk60" GroupName="BatChk" Style="{StaticResource SegItem}" Content="1 hour" Tag="60"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== OVERLAY ========================== -->
          <ScrollViewer x:Name="PageOverlay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Overlay" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Live stats on top of your games. Vento shows it on its own when a game starts." Style="{StaticResource Body}"
                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>
              <!-- A game-like scene with the overlay where it will sit -->
              <Border CornerRadius="8" Height="168" BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" ClipToBounds="True" Background="{StaticResource SceneBrush}">
                <Grid>
                  <Ellipse Width="420" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-120" Opacity="0.55">
                    <Ellipse.Fill>
                      <RadialGradientBrush>
                        <GradientStop Color="#FFB46A" Offset="0"/>
                        <GradientStop Color="#00FFB46A" Offset="1"/>
                      </RadialGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Width="360" Height="220" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-90,0,0" Opacity="0.5">
                    <Ellipse.Fill>
                      <RadialGradientBrush>
                        <GradientStop Color="#5AA9FF" Offset="0"/>
                        <GradientStop Color="#005AA9FF" Offset="1"/>
                      </RadialGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Border x:Name="OsdMock" CornerRadius="8" Background="{DynamicResource OsdPanelBrush}" BorderBrush="{DynamicResource OsdBorderBrush}" BorderThickness="1"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="12,7">
                    <!-- built by Glass.ps1 from the metrics switched on below -->
                    <StackPanel x:Name="OsdItems" Orientation="Horizontal"/>
                  </Border>
                  <TextBlock Text="Preview" Style="{StaticResource Caption}" Foreground="#99FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,10"/>
                </Grid>
              </Border>

              <TextBlock Text="Layout" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <UniformGrid Columns="4" Margin="-4,0">
                <RadioButton x:Name="LayBlade" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8" IsChecked="True">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" BorderBrush="{DynamicResource OsdAccentBrush}" BorderThickness="2,0,0,0" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,3">
                        <StackPanel>
                          <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="13" Foreground="{DynamicResource OsdAccentBrush}"/>
                          <TextBlock Text="60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}"/>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Blade" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayStrip" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="144" Style="{StaticResource OsdTiny}" Foreground="{DynamicResource OsdAccentBrush}"/>
                          <TextBlock Text="  60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}"/>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Strip" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayHero" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2,7,4">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="20" Foreground="{DynamicResource OsdAccentBrush}"/>
                            <TextBlock Text=" FPS" Style="{StaticResource OsdTiny}" FontSize="7" Foreground="{DynamicResource OsdLabBrush}" Margin="0,5,0,0"/>
                          </StackPanel>
                          <TextBlock Text="60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}" FontSize="7"/>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Hero" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayPills" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,8">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                        <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="7" Padding="6,1" Margin="0,0,3,0"><TextBlock Text="144" Style="{StaticResource OsdTiny}" Foreground="{DynamicResource OsdAccentBrush}"/></Border>
                        <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="7" Padding="6,1" Margin="0,0,3,0"><TextBlock Text="60&#xB0;" Style="{StaticResource OsdTiny}"/></Border>
                        <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="7" Padding="6,1"><TextBlock Text="54&#xB0;" Style="{StaticResource OsdTiny}"/></Border>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Pills" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayGhost" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,0">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,6">
                        <StackPanel.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="5" Opacity="0.9"/></StackPanel.Effect>
                        <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="17" Foreground="{DynamicResource OsdAccentBrush}"/>
                        <TextBlock Text="60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Ghost" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayMicro" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,0">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,7">
                        <StackPanel.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.9"/></StackPanel.Effect>
                        <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="7" Foreground="{DynamicResource OsdAccentBrush}"/>
                        <TextBlock Text="  60&#xB0;  54&#xB0;  1951" Style="{StaticResource OsdTiny}" FontSize="7"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Micro" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="LayThermo" GroupName="Lay" Style="{StaticResource ModeCard}" Padding="8" Margin="4,0,4,0">
                  <StackPanel>
                    <Border Style="{StaticResource MiniScene}">
                      <Border Background="{DynamicResource OsdPanelBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="5,4,8,4">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="3" CornerRadius="1.5" Margin="0,0,6,0">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#6FB1FF" Offset="0"/>
                                <GradientStop Color="#F5A45C" Offset="0.6"/>
                                <GradientStop Color="#F2606B" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <StackPanel>
                            <TextBlock Text="144" Style="{StaticResource OsdTiny}" FontSize="12" Foreground="{DynamicResource OsdAccentBrush}"/>
                            <TextBlock Text="60&#xB0;  54&#xB0;" Style="{StaticResource OsdTiny}"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Border>
                    <TextBlock Text="Thermo" Style="{StaticResource Body}" FontSize="13" Margin="2,0,0,2"/>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>

              <TextBlock Text="What it shows" Style="{StaticResource BodyStrong}" Margin="0,20,0,2"/>
              <TextBlock Text="The first one switched on is the big number. Each can have its own color." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <!-- one row per metric (built by Glass.ps1): color dot, name, switch -->
              <Border Style="{StaticResource Card}" Padding="16,2,16,2">
                <UniformGrid x:Name="MetricRows" Columns="2"/>
              </Border>

              <TextBlock Text="Look" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Color" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="OsdThemeName" Text="Sirocco" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ThSirocco" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#6FB1FF" Tag="sirocco" IsChecked="True" ToolTip="Sirocco"/>
                    <RadioButton x:Name="ThEmber" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#FFB25C" Tag="ember" ToolTip="Ember"/>
                    <RadioButton x:Name="ThVenom" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#7CF29B" Tag="venom" ToolTip="Venom"/>
                    <RadioButton x:Name="ThViolet" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#B18CFF" Tag="violet" ToolTip="Violet"/>
                    <RadioButton x:Name="ThCrimson" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#FF6B7E" Tag="crimson" ToolTip="Crimson"/>
                    <RadioButton x:Name="ThMono" GroupName="OsdTh" Style="{StaticResource Swatch}" Background="#F2F4F7" Tag="mono" ToolTip="Mono"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Position" Style="{StaticResource Body}"/>
                    <TextBlock x:Name="OsdCornerName" Text="Top right" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <!-- a tiny screen with a spot per corner -->
                  <Border Grid.Column="2" Width="84" Height="52" CornerRadius="5" BorderBrush="#5DFFFFFF" BorderThickness="1.5" Background="#0AFFFFFF">
                    <Grid Margin="3">
                      <RadioButton x:Name="CorTL" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="Top left"/>
                      <RadioButton x:Name="CorTR" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="Top right" IsChecked="True"/>
                      <RadioButton x:Name="CorBL" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Tag="Bottom left"/>
                      <RadioButton x:Name="CorBR" GroupName="Cor" Style="{StaticResource CornerDot}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Tag="Bottom right"/>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE740;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Size" Style="{StaticResource Body}"/>
                    <TextBlock Text="Scales the whole overlay" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" x:Name="OsdScaleV" Text="100%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" x:Name="OsdScale" Style="{StaticResource FluentSlider}" Minimum="60" Maximum="160" Value="100"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Opacity" Style="{StaticResource Body}"/>
                    <TextBlock Text="Let a little of the game show through" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" x:Name="OsdOpacityV" Text="100%" Style="{StaticResource Body}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <Slider Grid.Column="3" x:Name="OsdOpacity" Style="{StaticResource FluentSlider}" Minimum="40" Maximum="100" Value="100"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7C2;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Exact position" Style="{StaticResource Body}"/>
                    <TextBlock Text="Drag the overlay anywhere on screen, or snap it back to its corner" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FluentButton}" Content="Move on screen" FontSize="13" MinHeight="30" Padding="12,4"/>
                    <Button Style="{StaticResource FluentButton}" Content="Reset" FontSize="13" MinHeight="30" Padding="12,4" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock Text="Behavior" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE81E;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Show overlay" Style="{StaticResource Body}"/>
                    <TextBlock Text="Auto appears with a game and hides after it" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton GroupName="OsdMode" Style="{StaticResource SegItem}" Content="Auto" IsChecked="True"/>
                      <RadioButton GroupName="OsdMode" Style="{StaticResource SegItem}" Content="Always"/>
                      <RadioButton GroupName="OsdMode" Style="{StaticResource SegItem}" Content="Off"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7EF;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Hide from screen capture" Style="{StaticResource Body}"/>
                    <TextBlock Text="Invisible to OBS, Discord and screenshots" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Show on the second display" Style="{StaticResource Body}"/>
                    <TextBlock Text="Keep the game screen completely clean" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- =========================== SETTINGS ========================= -->
          <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="36,26,36,28">
              <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Appearance" Style="{StaticResource BodyStrong}" Margin="0,22,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEB41;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Window material" Style="{StaticResource Body}"/>
                    <TextBlock Text="Mica matches Windows Settings and takes its tone from your theme; Acrylic shows what is behind" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource SegHost}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="MatAcrylic" GroupName="Mat" Style="{StaticResource SegItem}" Content="Acrylic" Tag="3"/>
                      <RadioButton x:Name="MatMica" GroupName="Mat" Style="{StaticResource SegItem}" Content="Mica" Tag="2" IsChecked="True"/>
                      <RadioButton x:Name="MatMicaAlt" GroupName="Mat" Style="{StaticResource SegItem}" Content="Mica Alt" Tag="4"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Accent color" Style="{StaticResource Body}"/>
                    <TextBlock Text="Follows the accent you picked in Windows" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AccentHex" Text="#4CC2FF" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Width="24" Height="24" CornerRadius="4" Background="{DynamicResource AccentBrush}" BorderBrush="#24FFFFFF" BorderThickness="1"/>
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock x:Name="ShortcutsTitle" Text="Shortcuts" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <!-- One card, many rows (built by Glass.ps1). Record listens for the next combo. -->
              <Border Style="{StaticResource Card}" Padding="16,2,16,2">
                <StackPanel x:Name="HotkeyRows"/>
              </Border>

              <TextBlock Text="Startup" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7E8;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" Style="{StaticResource Body}"/>
                    <TextBlock Text="Fans are under control from the moment you sign in" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE7C4;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Keep running in the tray" Style="{StaticResource Body}"/>
                    <TextBlock Text="Closing the window leaves fan control on" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE9F3;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Check for updates automatically" Style="{StaticResource Body}"/>
                    <TextBlock Text="Downloads are verified before they install" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                </Grid>
              </Border>

              <TextBlock Text="About" Style="{StaticResource BodyStrong}" Margin="0,20,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}">
                    <Path Data="{StaticResource FanGeometry}" Style="{StaticResource FluentIcon}" Fill="{DynamicResource AccentBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Vento" Style="{StaticResource Body}"/>
                    <TextBlock Text="Version 1.8.0 &#xB7; design preview" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource FluentButton}" Content="Check for updates" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- Not part of the app: switches for trying the error and notice states -->
              <TextBlock Text="Preview states" Style="{StaticResource BodyStrong}" Margin="0,20,0,2"/>
              <TextBlock Text="Only in this design preview, to see how Vento looks when something needs you." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE783;" Style="{StaticResource Glyph}" Foreground="#FF99A4" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Fan driver missing" Style="{StaticResource Body}"/>
                    <TextBlock Text="What you see when PawnIO is uninstalled or stopped" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <CheckBox x:Name="PrevNoDriver" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Notifications" Style="{StaticResource Body}"/>
                    <TextBlock Text="Real Windows notifications, as Vento sends them" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PrevToastTemp" Style="{StaticResource FluentButton}" Content="Temperature" FontSize="13" MinHeight="30" Padding="12,4"/>
                    <Button x:Name="PrevToastBat" Style="{StaticResource FluentButton}" Content="Low battery" FontSize="13" MinHeight="30" Padding="12,4" Margin="8,0,0,0"/>
                    <Button x:Name="PrevToastDrv" Style="{StaticResource FluentButton}" Content="Driver" FontSize="13" MinHeight="30" Padding="12,4" Margin="8,0,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
