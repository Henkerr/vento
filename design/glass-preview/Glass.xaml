                        <TextBlock Grid.Row="2" Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Displays" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Day preset" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="ApplyWork" Style="{StaticResource AccentButton}" Content="Apply" FontSize="13" MinHeight="30" Padding="16,4" Tag="Work"/>
                        <Button Style="{StaticResource FluentButton}" Content="Edit" FontSize="13" MinHeight="30" Padding="16,4" Margin="8,0,0,0"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
                <!-- New -->
                <Grid Margin="6,0,0,0" Cursor="Hand" Background="Transparent">
                  <Rectangle RadiusX="8" RadiusY="8" Stroke="#3DFFFFFF" StrokeThickness="1" StrokeDashArray="4 3"/>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#0FFFFFFF" HorizontalAlignment="Center">
                      <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="New profile" Style="{StaticResource BodyStrong}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Save what is set right now under a name" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </UniformGrid>
              <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE765;" Style="{StaticResource Glyph}" HorizontalAlignment="Center"/></Border>
                  <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="Next profile shortcut" Style="{StaticResource Body}"/>
