                  <Button x:Name="GoHotkeys" Grid.Column="2" Style="{StaticResource FluentButton}" Content="Set in Settings" FontSize="13" MinHeight="30" Padding="12,4"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ========================== DISPLAYS ========================== -->
          <ScrollViewer x:Name="PageDisplays" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
