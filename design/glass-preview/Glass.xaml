                  <Slider Grid.Column="3" x:Name="LimCpu" Style="{StaticResource FluentSlider}" Minimum="60" Maximum="95" Value="85"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource SettingsCard}">
